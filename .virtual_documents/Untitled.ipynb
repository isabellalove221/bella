import numpy as np


# 3.1  1D NumPy Arrays


lst = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]
arr = np.array(lst)

arr_times4 = arr * 4
print(arr_times4)


mean_val = np.mean(arr)
print(mean_val)


median_val = np.median(arr)
print(median_val)


std_val = np.std(arr)
print(std_val)


min_index = np.argmin(arr)
max_index = np.argmax(arr)

print(min_index)
print(max_index)


print(arr[min_index])


print(arr[max_index])


print(np.min(arr))
print(np.max(arr))


# yes they match


greater_than_20 = arr[arr > 20]
print(greater_than_20)


# 3.2 2D NumPy Arrays


matrix = np.array([
    [5, 12, 17, 9],
    [8, 21, 14, 3],
    [6, 13, 19, 11]
])
print(matrix.shape)
print(matrix.shape[0])
print(matrix.shape[1])


print(matrix[:, 2])


print(matrix[1])


matrix_times2 = matrix * 2
print(matrix_times2)


mean_colms = np.mean(matrix, axis=0)
print(mean_colms)


overall_mean = np.mean(matrix)
print(overall_mean)


max_each_row = np.max(matrix, axis=1)
print(max_each_row)


min_each_colm = np.min(matrix, axis=0)
print(min_each_colm)


flat = matrix.flatten()
print(flat)
print(flat.shape)


# the 2D array was converted to a 1D array/list


min_index = np.argmin(flat)
max_index = np.argmax(flat)
print(min_index)
print(max_index)


min_coords = np.unravel_index(min_index, matrix.shape)
max_coords = np.unravel_index(max_index, matrix.shape)
print(min_coords)
print(max_coords)
print(matrix[min_coords])
print(matrix[max_coords])


greater_than_15 = matrix[matrix > 15]
print(greater_than_15)



sorted_matrix = np.sort(matrix, axis=1)
print(sorted_matrix)



